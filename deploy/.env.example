# ClaudeService — переменные окружения.
# Скопируй в корень проекта как ../.env и заполни (install.sh/install.ps1 делают это сами).
# Postgres не используется — только Redis (поднимается из docker-compose.yml).
# Файл .env в .gitignore: секреты не хардкодим в коде и не коммитим.

# ─────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНЫЕ — без них devbot не поднимется
# ─────────────────────────────────────────────────────────────

# Токен Telegram-бота от @BotFather (никому не показывать).
DEVBOT_TOKEN=

# Chat ID администратора (единственный, кому бот отвечает и шлёт уведомления).
# Узнать свой id: напиши @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=

# Публичный HTTPS-URL вебхука бота. nginx проксирует его в devbot по сети claude-net.
WEBHOOK_URL=https://ВАШ-ДОМЕН/devbot/webhook

# ─────────────────────────────────────────────────────────────
# REDIS — внутри compose-сети, обычно менять не нужно
# ─────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────
# НЕОБЯЗАТЕЛЬНЫЕ — переопределения для скриптов хоста (Linux/VPS).
# У всех есть дефолты; задавай, только если отходишь от стандарта.
# Читаются из окружения процесса (systemd/шелл), не самим devbot.
# ─────────────────────────────────────────────────────────────

# Имя tmux-сессии, в которой крутится Claude CLI (start-claude.sh, switch-project.sh).
# CLAUDE_SESSION=claude

# Имя контейнера Redis для host-скриптов (tg-send.sh, tg-ask.sh, watch-triggers.sh).
# CS_REDIS_CONTAINER=claudeservice-redis-1

# Путь к этому .env для host-скриптов, если он лежит не рядом со scripts/.
# CS_ENV_FILE=/home/boris/projects/ClaudeService/.env

# Файл-указатель текущего проекта (projects.sh).
# CURRENT_PROJECT_FILE=$HOME/.claude-current-project

# Проект по умолчанию, если указатель пуст/битый (projects.sh).
# DEFAULT_PROJECT=game
